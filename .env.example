# HTTPS origin only; do not append /mcp here.
MCP_PUBLIC_URL=https://your-service.up.railway.app
# Generate locally: openssl rand -hex 32. Never commit the real value.
MCP_ADMIN_PASSWORD=replace-with-at-least-24-random-bytes
# Optional automation token for MCP Inspector/CI; browsers should use OAuth.
# MCP_BEARER_TOKEN=replace-with-at-least-32-random-bytes
ASC_TRANSPORT=http
PORT=8080
MCP_DATA_DIR=/data
MCP_MAX_UPLOAD_BYTES=10737418240
MCP_MAX_SESSIONS=32
# Set ASC_COMPANIES_JSON in Railway Variables. Preserve PEM newlines as JSON escapes.
# {"companies":[{"id":"team1","name":"My Team","key_id":"KEY_ID","issuer_id":"ISSUER_ID","key_content":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----","vendor_number":"OPTIONAL"}]}
